  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "node scripts/check-web-env.mjs && vite build",
    "preview": "vite preview",
    "test": "node --import ./scripts/register-payment-tests.mjs --test src/components/payments.test.js src/utils/photoUrl.test.js",
