    "format:payments": "prettier --write src/components/{PaymentModal,EscrowStatusCard,RefundPanel,FinancialTimeline,DisputeResolutionModal,PaymentReviewQueue}.jsx src/components/paymentFlow.js src/components/payments.test.js src/components/PaymentModal.css",
    "format:payments:check": "prettier --check src/components/{PaymentModal,EscrowStatusCard,RefundPanel,FinancialTimeline,DisputeResolutionModal,PaymentReviewQueue}.jsx src/components/paymentFlow.js src/components/payments.test.js src/components/PaymentModal.css"
  },
  "dependencies": {
