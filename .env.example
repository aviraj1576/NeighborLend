# ================================================================
# NeighborLend Environment Variables
# Copy this file to .env before starting development:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)
# ================================================================

# --- Mode A: Frontend-Only Development (Recommended) ---
# If you only want to work on the UI, point this to the live deployed backend:
VITE_API_BASE_URL=https://neighborlend-6z0f.onrender.com/api

# Optional: Google OAuth Web Client ID for Google Sign-In
VITE_GOOGLE_CLIENT_ID=955509937979-plievnr21ho986ho13vcfr21outcqmhm.apps.googleusercontent.com
GOOGLE_CLIENT_ID=955509937979-plievnr21ho986ho13vcfr21outcqmhm.apps.googleusercontent.com

# --- Mode B: Local Backend Development (Optional) ---
# For instant zero-config local backend, use SQLite:
DATABASE_URL=sqlite:///./neighborlend.db
# Or use Supabase PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/postgres

APP_ENV=development
JWT_SECRET=neighborlend-super-secret-key-2026-prototype
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# File uploads & AI model
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8000
AI_MODEL_PATH=./ai_service/best_model.pt
AI_CONFIDENCE_THRESHOLD=0.45
MOCK_PAYMENTS=true

# Allowed CORS origins for local frontend dev servers
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
ADMIN_EMAILS=admin@neighborlend.com

# Supabase Storage (Required for persistent cloud photo storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo SMTP Configuration (For registration email verification codes)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Damage check (AI before/after comparison). Use "mock" for offline dev; "gemini" needs a key.
# Without a key the app still starts, but analyses are reported as "needs_review".
DAMAGE_PROVIDER=mock
DAMAGE_GEMINI_API_KEY=
