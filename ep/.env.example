# Documentation only: EP never loads the repository .env or this file automatically.
EP_DATA_DIR=.runtime
EP_MAX_UPLOAD_BYTES=10485760
EP_MAX_PIXELS=16000000
EP_MAX_DIMENSION=8192
# Unset = deny all protected endpoints. Local fixture grants only; never production credentials.
# EP_LOCAL_GRANTS_FILE=local-grants.json
# EP_CORS_ORIGINS=http://127.0.0.1:5173
